# ============================================================
#  EXEMPLO DE CONFIGURAÇÃO — ESTE ARQUIVO VAI NO GIT
#  Copie para .env e preencha com seus dados reais
# ============================================================

# Banco de Dados
DB_HOST=localhost
DB_NAME=nome_do_banco
DB_USER=root
DB_PASS=sua_senha_aqui

# E-mail (SMTP Gmail — use uma Senha de App, não a senha normal)
# Como gerar: https://myaccount.google.com/apppasswords
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# URL base do sistema (sem barra no final)
BASE_URL=http://localhost/projeto-faculdade/controle-estoque
